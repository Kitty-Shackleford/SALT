# Local full-stack testing mode. Run `npm run local:setup` to create the
# ignored .env.local file and generate the local-only secrets below.
NODE_ENV=development
DEPLOYMENT_MODE=local

APP_NAME=DayZ Dashboard Local
DASHBOARD_URL=http://localhost:3000
PLAYER_PORTAL_URL=http://localhost:3000
RATE_LIMIT_ENABLED=false
SESSION_SECURE_COOKIE=false
PORT=3000
LISTEN_HOST=127.0.0.1
LOCAL_DASHBOARD_PORT=3000
LOCAL_POSTGRES_PORT=55432

# Use a dedicated Discord test application and test guild. Register this OAuth
# callback: http://localhost:3000/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DASHBOARD_OWNER_DISCORD_ID=

# Generated by local:setup. Do not copy production values into this file.
SESSION_SECRET=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dayz-dashboard
POSTGRES_USER=dayz-dashboard
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true

# Local mode uses the real Nitrado API. Do not place a Nitrado token here:
# register it through the local bot's /register-token command so it is verified,
# bound to the exact Discord guild/server, and encrypted in the isolated DB.
NITRADO_API_BASE_URL=https://api.nitrado.net
NITRADO_HTTP_TIMEOUT_MS=15000
NITRADO_API_RETRIES=2
NITRADO_CACHE_TTL_MS=10000
NITRADO_CACHE_MAX_ENTRIES=500
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_API_TIMEOUT_MS=15000
GITHUB_API_RETRIES=2
GITHUB_CACHE_TTL_MS=15000
GITHUB_CACHE_MAX_ENTRIES=500
GITHUB_MAX_PAGES=20
EXTERNAL_API_MAX_RETRY_DELAY_MS=30000
POSTGRES_ADVISORY_LOCK_TIMEOUT_MS=10000

# Optional server-side AI provider. Per-user providers can instead be connected
# through the local dashboard.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_API_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=16384
