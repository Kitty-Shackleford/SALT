# Environment
NODE_ENV=production

# Runtime mode: full (hosted bot + website), bot (Discord bot only), or local
# (loopback-only bot + website testing through docker-compose.local.yml)
DEPLOYMENT_MODE=full

# Public instance configuration (required when DEPLOYMENT_MODE=full)
APP_NAME=DayZ Dashboard
DASHBOARD_URL=https://dashboard.example.com
PLAYER_PORTAL_URL=https://player.example.com
# Optional community invite shown by the website
DISCORD_INVITE_URL=https://discord.gg/your-invite

# Rate Limiting
# Set to 'false' to disable rate limiting (useful for testing)
# Set to 'true' to enable rate limiting (recommended for production)
RATE_LIMIT_ENABLED=true

# Session Security
# Set to 'true' when running behind HTTPS (nginx, cloudflare, etc.)
# Set to 'false' only for local HTTP development
SESSION_SECURE_COOKIE=true

# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Discord Bot
DISCORD_BOT_TOKEN=your_bot_token_here
# Initial global Dashboard Owner's Discord user ID (Developer Mode → Copy User ID).
# The bot verifies guild membership; the website verifies the same ID through
# Discord OAuth. Changing this value never silently replaces an existing owner.
DASHBOARD_OWNER_DISCORD_ID=
# Optional: set to your Discord server ID for instant slash command registration (recommended)
# Leave blank to register globally (commands may take up to 1 hour to appear)
DISCORD_GUILD_ID=your_discord_server_id_here

# Session Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_random_secret_here

# Encryption Key for storing Nitrado tokens - must be exactly 64 hex characters (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_encryption_key_here

# BASE_URL is a deprecated alias for DASHBOARD_URL and may be omitted.

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dayz-dashboard
POSTGRES_USER=dayz-dashboard
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_SSL=false
# Keep certificate verification enabled for hosted PostgreSQL. Set false only
# for a trusted private deployment using a self-signed certificate.
POSTGRES_SSL_REJECT_UNAUTHORIZED=true

# External API configuration. GitHub PATs and Nitrado tokens are entered through
# the authenticated dashboard/bot and encrypted in PostgreSQL.
NITRADO_API_BASE_URL=https://api.nitrado.net
NITRADO_HTTP_TIMEOUT_MS=15000
NITRADO_API_RETRIES=2
NITRADO_CACHE_TTL_MS=10000
NITRADO_CACHE_MAX_ENTRIES=500
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_API_TIMEOUT_MS=15000
GITHUB_API_RETRIES=2
GITHUB_CACHE_TTL_MS=15000
GITHUB_CACHE_MAX_ENTRIES=500
GITHUB_MAX_PAGES=20
EXTERNAL_API_MAX_RETRY_DELAY_MS=30000

# Server-side OpenAI-compatible inference provider. Keep AI_API_KEY only in the
# deployment environment or secret manager; it is never sent to the browser.
AI_API_BASE_URL=https://api.openai.com/v1/
AI_API_KEY=replace_with_provider_key
AI_MODEL=gpt-4o-mini
AI_API_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=16384

# Database lock safety timeout (milliseconds)
POSTGRES_ADVISORY_LOCK_TIMEOUT_MS=10000

# Port (optional, defaults to 3000)
PORT=3000
